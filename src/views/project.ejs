<%- include('partials/header') %>

    <main>
        <h1>
            <%= project.title %>
        </h1>

        <p>
            <%= project.description %>
        </p>
        <p>
            <strong>Date:</strong>
            <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' , day: 'numeric' })
                %>
        </p>
        <p><strong>Location:</strong>
            <%= project.location %>
        </p>

        <p><strong>Partner organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>
        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
        <% } %>

        <h2>Categories</h2>
        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
                <% }); %>
        </ul>
        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
        <% } %>
        <% if (isLoggedIn) { %>
            <% if (userProjects.some(up => up.project_id === project.project_id)) { %>
                <p class="volunteered">You have volunteered for this project.</p>
                <form method="POST" action="/remove-volunteer/<%= project.project_id %>">
                    <button type="submit">Remove Volunteer Commitment</button>
                </form>
            <% } else { %>
                <form method="POST" action="/volunteer/<%= project.project_id %>">
                    <button type="submit">Volunteer for this project</button>
                </form>
            <% } %>
        <% } %>
        
    </main>

    <%- include('partials/footer') %>