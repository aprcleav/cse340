<%- include('partials/header') -%>
    <!-- fill in the values of the form fields with the existing project data and create a dropdown list for the organization -->

    <main>
        <h1>Edit Project</h1>
        <form action="/edit-project/<%= project.project_id %>" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" value="<%= project.title %>" required maxlength="150" />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required
                    maxlength="500"><%= project.description %></textarea>
            </div>

            <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" value="<%= project.date instanceof Date
            ? project.date.toISOString().slice(0, 10)
            : String(project.date).slice(0, 10) %>" required />
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value="<%= project.location %>" required
                    maxlength="150" />
            </div>

            <div class="form-group">
                <label for="organization">Partner Organization</label>
                <select id="organization" name="organizationId" required>
                    <option value="">Select an organization</option>
                    <% organizations.forEach(org=> { %>
                        <option value="<%= org.organization_id %>"
                            <%=Number(org.organization_id)===Number(project.organization_id) ? 'selected' : '' %>>
                            <%= org.name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <button type="submit">Update Project</button>
        </form>
    </main>
    <%- include('partials/footer') -%>