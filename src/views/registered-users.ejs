<%- include('partials/header') %>
<main>
    <h1>
        <%= title %>
    </h1>
    <ul>
        <% users.forEach(user => { %>
                <li>
                    <p><strong>Name: </strong><%= user.name %></p>
                    <p><strong>Email: </strong><%= user.email %></p>
                    <p><strong>Role: </strong><%= user.role_name %></p>
                </li>
            <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>