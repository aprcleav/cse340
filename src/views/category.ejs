<%- include('partials/header') %>

    <main>
        <h1>
            <%= category.name %>
        </h1>
        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/edit-category/<%= category.category_id %>">Edit Category Name</a></p>
        <% } %>

        <h2>Related Service Projects</h2>
        <ul>
            <% serviceProjects.forEach(project=> { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </li>
                <% }); %>
        </ul>
    </main>

    <%- include('partials/footer') %>